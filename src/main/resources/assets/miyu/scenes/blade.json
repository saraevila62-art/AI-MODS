{
  "format": 1,
  "name": "яндере_меч",
  "npc": {
    "winks": [],
    "cues": [
      {
        "kind": "text",
        "speech": true,
        "expression": "playful",
        "tick": 45,
        "length": 50,
        "text": "смотри-ка, что у меня есть~",
        "source": "",
        "label": "",
        "offset": 0,
        "volume": 1.0,
        "color": 16718362,
        "screenY": 75
      },
      {
        "kind": "text",
        "speech": true,
        "expression": "focused",
        "tick": 95,
        "length": 45,
        "text": "не двигайся... вот так, умница",
        "source": "",
        "label": "",
        "offset": 0,
        "volume": 1.0,
        "color": 16718362,
        "screenY": 75
      },
      {
        "kind": "text",
        "speech": true,
        "expression": "focused",
        "tick": 140,
        "length": 45,
        "text": "ты ведь не хотел уйти от меня, правда?",
        "source": "",
        "label": "",
        "offset": 0,
        "volume": 1.0,
        "color": 16718362,
        "screenY": 75
      },
      {
        "kind": "text",
        "speech": true,
        "expression": "focused",
        "tick": 185,
        "length": 45,
        "text": "если уйдёшь — я не смогу себя контролировать",
        "source": "",
        "label": "",
        "offset": 0,
        "volume": 1.0,
        "color": 16718362,
        "screenY": 75
      },
      {
        "kind": "text",
        "speech": true,
        "expression": "focused",
        "tick": 222,
        "length": 40,
        "text": "скажи, что ты только мой. скажи!",
        "source": "",
        "label": "",
        "offset": 0,
        "volume": 1.0,
        "color": 16718362,
        "screenY": 75
      },
      {
        "kind": "text",
        "speech": true,
        "expression": "concern",
        "tick": 245,
        "length": 50,
        "text": "...прости. я напугала тебя?",
        "source": "",
        "label": "",
        "offset": 0,
        "volume": 1.0,
        "color": 16731528,
        "screenY": 85
      },
      {
        "kind": "text",
        "speech": true,
        "expression": "concern",
        "tick": 285,
        "length": 45,
        "text": "я просто так боюсь тебя потерять...",
